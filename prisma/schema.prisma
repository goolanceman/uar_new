generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

// ─── People & Auth ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("DONOR") // ADMIN | VOLUNTEER | DONOR | BENEFICIARY
  status    String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED
  phone     String?
  city      String?
  pan       String?
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VolunteerApplication {
  id          String    @id @default(cuid())
  userId      String?
  fullName    String
  email       String
  phone       String
  city        String
  occupation  String?
  skills      String?
  availability String?
  motivation  String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote  String?
  tempCreds   String? // JSON {email, password} shown once
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
}

// ─── MDM (Master Data Management) ────────────────────────────────────────────

model Master {
  id        String  @id @default(cuid())
  category  String // CAMPAIGN_CATEGORY | CONDITION | SKILL | ANIMAL_SPECIES | CITY | UNIT | INVENTORY_CATEGORY | AMBULANCE_TYPE | EMERGENCY_TYPE | AVAILABILITY | DISTRIBUTION_TYPE | TASK_TYPE
  value     String
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@unique([category, value])
}

// ─── Campaigns & Donations ───────────────────────────────────────────────────

model Campaign {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  tagline        String
  category       String // AWARENESS | HEALTH | SAFETY | ANIMAL | NUTRITION | HYGIENE | MOBILITY
  description    String
  status         String     @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  targetAmount   Float      @default(0)
  raisedAmount   Float      @default(0)
  beneficiaries  Int        @default(0)
  volunteersEngaged Int     @default(0)
  icon           String     @default("heart")
  accent         String     @default("emerald")
  featured       Boolean    @default(false)
  helpline       String?
  createdAt      DateTime   @default(now())
  donations      Donation[]
}

model Donation {
  id          String    @id @default(cuid())
  receiptNo   String    @unique
  donorId     String?
  donorName   String
  email       String?
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  amount      Float
  type        String    @default("ONE_TIME") // ONE_TIME | MONTHLY
  method      String    @default("UPI") // UPI | CARD | BANK | CASH
  status      String    @default("COMPLETED") // PENDING | COMPLETED | FAILED
  message     String?
  isAnonymous Boolean   @default(false)
  pan         String?
  createdAt   DateTime  @default(now())
}

// ─── Adopt-a-Medicine (monthly tablets for the needy) ────────────────────────

model Cause {
  id            String   @id @default(cuid())
  code          String   @unique // UAR-MED-0001
  patientName   String
  age           Int
  city          String
  condition     String // BP | DIABETES | THYROID | CARDIAC | ASTHMA | ARTHRITIS | OTHER
  monthlyCost   Float
  durationMonths Int
  story         String
  status        String   @default("SEEKING") // SEEKING | PARTIAL | ADOPTED | PAUSED
  adoptedById   String?
  adoptedByName String?
  raised        Float    @default(0)
  createdAt     DateTime @default(now())
  pledges       Pledge[]
}

model Pledge {
  id             String   @id @default(cuid())
  causeId        String
  cause          Cause    @relation(fields: [causeId], references: [id])
  donorId        String?
  donorName      String
  amountPerMonth Float
  months         Int      @default(6)
  startDate      DateTime @default(now())
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt      DateTime @default(now())
}

// ─── Animal Welfare (rescue / adoption / food pledges) ───────────────────────

model Animal {
  id           String         @id @default(cuid())
  name         String
  species      String // DOG | CAT | COW | BIRD | OTHER
  breed        String?
  ageMonths    Int            @default(12)
  gender       String         @default("MALE")
  story        String
  healthStatus String?
  vaccinated   Boolean        @default(false)
  sterilized   Boolean        @default(false)
  location     String
  status       String         @default("AVAILABLE") // AVAILABLE | FOSTERED | ADOPTED | CRITICAL
  monthlyFood  Float          @default(0)
  createdAt    DateTime       @default(now())
  pledges      AnimalPledge[]
}

model AnimalPledge {
  id          String   @id @default(cuid())
  animalId    String?
  animal      Animal?  @relation(fields: [animalId], references: [id])
  shelterFund String? // e.g. "Bengaluru Street Dog Food Fund" when not animal-specific
  donorId     String?
  donorName   String
  kind        String   @default("FOOD") // FOOD | MEDICAL | VACCINATION | SHELTER
  amount      Float
  frequency   String   @default("MONTHLY") // ONE_TIME | MONTHLY
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt   DateTime @default(now())
}

// ─── Ambulance & Green Corridor AI ───────────────────────────────────────────

model Ambulance {
  id          String    @id @default(cuid())
  code        String    @unique // KA-01-UAR-108
  type        String    @default("BLS") // BLS | ALS | PTV | NEONATAL
  status      String    @default("AVAILABLE") // AVAILABLE | ON_MISSION | MAINTENANCE
  base        String
  driverName  String
  driverPhone String?
  crew        String?
  equipment   String?
  missions    Mission[]
}

model Mission {
  id              String      @id @default(cuid())
  requestRef      String      @unique
  patientName     String
  contact         String
  emergencyType   String // CARDIAC | ACCIDENT | MATERNITY | BURN | TRANSFER | RESPIRATORY
  priority        String      @default("HIGH") // CRITICAL | HIGH | MEDIUM
  pickup          String
  destination     String
  ambulanceId     String?
  ambulance       Ambulance?  @relation(fields: [ambulanceId], references: [id])
  status          String      @default("REQUESTED") // REQUESTED | DISPATCHED | EN_ROUTE | ARRIVED | COMPLETED | CANCELLED
  progress        Int         @default(0) // 0-100 simulated journey
  route           String? // JSON [{name, congestion, lengthKm}]
  corridorActive  Boolean     @default(false)
  vehiclesAlerted Int         @default(0)
  timeSavedSec    Int         @default(0)
  etaMin          Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  events          CorridorEvent[]
}

model CorridorEvent {
  id              String   @id @default(cuid())
  missionId       String
  mission         Mission  @relation(fields: [missionId], references: [id])
  segment         String
  method          String // V2X_5G | CELL_BROADCAST | BLE_MESH | FM_RDS | SIREN
  congestion      String // LOW | MODERATE | HEAVY | GRIDLOCK
  vehiclesAlerted Int      @default(0)
  timeSavedSec    Int      @default(0)
  note            String?
  createdAt       DateTime @default(now())
}

// ─── Ration Kit System ───────────────────────────────────────────────────────

model KitTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  items       String // JSON [{name, qty, unit}]
  costPerUnit Float      @default(0)
  createdAt   DateTime   @default(now())
  batches     KitBatch[]
}

model KitBatch {
  id           String     @id @default(cuid())
  templateId   String
  template     KitTemplate @relation(fields: [templateId], references: [id])
  name         String
  totalUnits   Int
  scannedUnits Int        @default(0)
  instructions String?
  status       String     @default("READY") // READY | IN_PROGRESS | DEPLETED
  createdAt    DateTime   @default(now())
  units        KitUnit[]
}

model KitUnit {
  id             String    @id @default(cuid())
  batchId        String
  batch          KitBatch  @relation(fields: [batchId], references: [id])
  code           String    @unique // UAR-RK-2026-000001
  status         String    @default("READY") // READY | SCANNED | EXPIRED
  scannedAt      DateTime?
  scannedById    String?
  scannedByName  String?
  location       String?
}

// ─── Operations ──────────────────────────────────────────────────────────────

model Beneficiary {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  city          String
  category      String   @default("FAMILY") // FAMILY | ELDERLY | CHILD | DISABLED | PATIENT | DAILY_WAGE
  familySize    Int      @default(1)
  monthlyNeed   Float    @default(0)
  status        String   @default("ACTIVE") // ACTIVE | VERIFIED | INACTIVE
  onboardedById String?
  onboardedByName String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Distribution {
  id              String    @id @default(cuid())
  type            String    @default("RATION") // RATION | PAD | MEDICINE | ANIMAL_FEED | OTHER
  beneficiaryName String
  beneficiaryId   String?
  campaignId      String?
  items           String?
  itemCount       Int       @default(1)
  location        String
  volunteerId     String?
  volunteerName   String?
  date            DateTime  @default(now())
  notes           String?
  createdAt       DateTime  @default(now())
}

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  quantity    Float    @default(0)
  unit        String   @default("pcs")
  minQuantity Float    @default(0)
  location    String?
  updatedAt   DateTime @updatedAt
}

model VolunteerTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  assignedToId String?
  assigneeName String?
  type         String    @default("DISTRIBUTION") // DISTRIBUTION | KIT_SCAN | INVENTORY | EVENT | RESCUE | AMBULANCE
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
}

// ─── Engagement ──────────────────────────────────────────────────────────────

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW | RESOLVED
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  message   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorName String?
  action    String
  entity    String?
  detail    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
