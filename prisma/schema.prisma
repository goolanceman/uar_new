// United Angel Reach — Charitable Trust Management System
// Merged canonical schema: v1 modules preserved + v2 programmes (MDM, Kits,
// Adopt-a-Medicine, Animal Welfare, Green Corridor, volunteer approvals).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  name      String
  password  String // scrypt "salt:hash" (legacy plain values still verify)
  role      String   @default("DONOR") // ADMIN | VOLUNTEER | DONOR | BENEFICIARY
  status    String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED (PENDING = volunteer awaiting approval)
  avatar    String?
  isActive  Boolean  @default(true)
  city      String?
  pan       String?
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations     Donation[]
  volunteer     Volunteer?
  beneficiary   Beneficiary?
  donorProfile  Donor?     @relation("DonorUser")
  notifications Notification[]
  activities    ActivityLog[]

  @@map("users")
}

// ==================== DONATION MODULE ====================

model Donor {
  id                 String   @id @default(cuid())
  type               String   @default("INDIVIDUAL") // INDIVIDUAL | ORGANISATION | CORPORATE
  organizationName   String?
  name               String
  email              String   @unique
  phone              String?
  altPhone           String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  pan                String?
  language           String?  // preferred communication language
  source             String?  // WEB | OFFLINE | IMPORT | REFERRAL | EVENT
  category           String?  // MAJOR | MONTHLY | ONE_TIME | CORPORATE | CSR
  wants80g           Boolean  @default(true)
  anonymousByDefault Boolean  @default(false)
  emailOptIn         Boolean  @default(true)
  smsOptIn          Boolean  @default(true)
  whatsappOptIn      Boolean  @default(true)
  tags               String?  // JSON ["volunteer","board"]
  notes              String?
  userId             String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User?      @relation("DonorUser", fields: [userId], references: [id])
  donations Donation[]

  @@map("donors")
}

model Donation {
  id                 String  @id @default(cuid())
  donorId            String?
  donorRefId         String? // → Donor (CRM link)
  donorName          String
  donorEmail         String
  donorPhone         String?
  amount             Float
  currency           String  @default("INR")
  type               String  @default("ONE_TIME") // ONE_TIME | RECURRING
  recurringFrequency String? // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  nextChargeAt       DateTime?
  category           String  @default("GENERAL") // GENERAL | MEDICAL | FOOD_DISTRIBUTION | SANITARY_PADS | EDUCATION_SUPPORT | EMERGENCY | ANIMAL_WELFARE | MOBILITY | AWARENESS
  paymentMethod      String  @default("UPI") // UPI | RAZORPAY | CARD | CASH | BANK_TRANSFER | CHEQUE
  paymentProvider    String? // RAZORPAY | CASHFREE | PAYU | STRIPE | MANUAL
  paymentStatus      String  @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED | CANCELLED
  transactionId      String?
  gatewayOrderId     String?
  fees               Float   @default(0)
  netAmount          Float?
  settlementDate     DateTime?
  receiptNumber      String  @unique
  receiptStatus      String  @default("ISSUED") // PENDING | ISSUED | CANCELLED | REISSUED
  receiptIssuedAt    DateTime?
  campaignId         String?
  message            String?
  isAnonymous        Boolean @default(false)
  pan                String? // for 80G receipt
  refundAmount       Float?
  refundReason       String?
  refundedAt         DateTime?
  internalNotes      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  donor    User?      @relation(fields: [donorId], references: [id])
  donorRef Donor?     @relation(fields: [donorRefId], references: [id])
  campaign Campaign?  @relation(fields: [campaignId], references: [id])

  @@map("donations")
}

// ==================== CAMPAIGN MANAGEMENT ====================

model Campaign {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  tagline           String   @default("")
  description       String
  category          String   @default("GENERAL") // see Donation.category
  targetAmount      Float
  raisedAmount      Float    @default(0)
  currency          String   @default("INR")
  startDate         DateTime @default(now())
  endDate           DateTime?
  location          String?
  images            String?
  status            String   @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | COMPLETED | CANCELLED
  createdBy         String   @default("system")
  icon              String   @default("heart") // lucide icon name
  accent            String   @default("emerald") // orange|cyan|fuchsia|amber|teal|lime|red|emerald|pink
  helpline          String?
  featured          Boolean  @default(false)
  urgent            Boolean  @default(false)
  minDonation       Float?
  taxEligible       Boolean  @default(true)
  videoUrl          String?
  gallery           String? // JSON [urls]
  budgetBreakdown   String? // JSON [{head, amount}]
  coordinatorName   String?
  coordinatorPhone  String?
  seoTitle          String?
  seoDescription    String?
  beneficiaries     Int      @default(0)
  volunteersEngaged Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  donations Donation[]

  @@map("campaigns")
}

// ==================== BENEFICIARY MANAGEMENT ====================

model Beneficiary {
  id            String  @id @default(cuid())
  userId        String? @unique
  name          String
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  category      String  @default("OTHER") // WIDOW | ORPHAN | STUDENT | ELDERLY | DISABLED | SINGLE_MOTHER | POOR_FAMILY | PATIENT | DAILY_WAGE | OTHER
  urgencyLevel  String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  familyMembers Int     @default(1)
  monthlyIncome Float?
  monthlyNeed   Float?
  needs         String?
  documents     String?
  notes         String?
  isActive      Boolean @default(true)
  onboardedByName String?
  caseStatus    String  @default("INTAKE") // INTAKE | VERIFICATION | ACTIVE | CLOSED | REJECTED
  caseWorker    String?
  verificationStatus String @default("PENDING") // PENDING | DOCUMENTS_REQUESTED | VERIFIED | REJECTED
  guardian      String?
  age           Int?
  gender        String?
  photoConsent  Boolean @default(false)
  intakeDate    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id])
  distributions    Distribution[]
  padDistributions PadDistribution[]
  caseNotes        BeneficiaryNote[]
  requests         BeneficiaryRequest[]

  @@map("beneficiaries")
}

model BeneficiaryNote {
  id            String   @id @default(cuid())
  beneficiaryId String
  authorName    String?
  note          String
  createdAt     DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_notes")
}

model BeneficiaryRequest {
  id            String   @id @default(cuid())
  beneficiaryId String?
  userId        String?
  name          String
  phone         String?
  category      String   @default("OTHER")
  urgency       String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  details       String
  status        String   @default("PENDING") // PENDING | IN_REVIEW | APPROVED | FULFILLED | REJECTED
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  @@map("beneficiary_requests")
}

// ==================== VOLUNTEER MANAGEMENT ====================

model Volunteer {
  id               String  @id @default(cuid())
  userId           String  @unique
  skills           String?
  availability     String?
  assignedArea     String?
  emergencyContact String?
  idProof          String?
  status           String  @default("PENDING") // PENDING | ACTIVE | INACTIVE | SUSPENDED
  joinedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id])
  tasks        VolunteerTask[]
  attendances  VolunteerAttendance[]
  distributions Distribution[]

  @@map("volunteers")
}

model VolunteerApplication {
  id           String    @id @default(cuid())
  userId       String?
  fullName     String
  email        String
  phone        String
  city         String
  occupation   String?
  skills       String?
  availability String?
  motivation   String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?
  tempCreds    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@map("volunteer_applications")
}

model VolunteerTask {
  id            String    @id @default(cuid())
  volunteerId   String
  title         String
  description   String?
  type          String    @default("DISTRIBUTION") // DISTRIBUTION | KIT_SCAN | INVENTORY | EVENT | RESCUE | AMBULANCE
  priority      String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  location      String?
  scheduledDate DateTime
  status        String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  completedAt   DateTime?
  notes         String?
  refType       String? // DISTRIBUTION | CAMPAIGN | EVENT | MISSION — what this task serves
  refId         String? // id of the linked record
  createdFrom   String    @default("MANUAL") // AUTO | MANUAL
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([refType, refId])
  @@map("volunteer_tasks")
}

model VolunteerAttendance {
  id          String    @id @default(cuid())
  volunteerId String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hours       Float?
  location    String?
  notes       String?
  createdAt   DateTime  @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])

  @@unique([volunteerId, date])
  @@map("volunteer_attendances")
}

// ==================== MDM (MASTER DATA MANAGEMENT) ====================

model Master {
  id        String  @id @default(cuid())
  category  String // CONDITION | ANIMAL_SPECIES | CITY | AVAILABILITY | SKILL | AMBULANCE_TYPE | EMERGENCY_TYPE | INVENTORY_CATEGORY | DISTRIBUTION_TYPE | TASK_TYPE | UNIT | BENEFICIARY_CATEGORY | DONATION_CATEGORY
  value     String
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@unique([category, value])
  @@map("masters")
}

// ==================== ADOPT-A-MEDICINE ====================

model Cause {
  id             String   @id @default(cuid())
  code           String   @unique // UAR-MED-0001
  patientName    String
  age            Int
  city           String
  condition      String // BP | DIABETES | THYROID | CARDIAC | ASTHMA | ARTHRITIS | OTHER
  monthlyCost    Float
  durationMonths Int
  story          String
  status         String   @default("SEEKING") // SEEKING | PARTIAL | ADOPTED | PAUSED
  adoptedById    String?
  adoptedByName  String?
  raised         Float    @default(0) // sum of ACTIVE monthly pledges
  createdAt      DateTime @default(now())

  pledges Pledge[]

  @@map("causes")
}

model Pledge {
  id             String   @id @default(cuid())
  causeId        String
  donorId        String?
  donorName      String
  amountPerMonth Float
  months         Int      @default(6)
  startDate      DateTime @default(now())
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt      DateTime @default(now())

  cause Cause @relation(fields: [causeId], references: [id])

  @@map("pledges")
}

// ==================== ANIMAL WELFARE ====================

model Animal {
  id           String   @id @default(cuid())
  name         String
  species      String   @default("DOG") // DOG | CAT | COW | BIRD | OTHER
  breed        String?
  ageMonths    Int      @default(12)
  gender       String   @default("MALE")
  story        String
  healthStatus String?
  vaccinated   Boolean  @default(false)
  sterilized   Boolean  @default(false)
  location     String
  status       String   @default("AVAILABLE") // AVAILABLE | FOSTERED | ADOPTED | CRITICAL
  monthlyFood  Float    @default(0)
  adoptedById  String?
  adoptedByName String?
  createdAt    DateTime @default(now())

  pledges AnimalPledge[]

  @@map("animals")
}

model AnimalPledge {
  id          String   @id @default(cuid())
  animalId    String?
  shelterFund String?
  donorId     String?
  donorName   String
  kind        String   @default("FOOD") // FOOD | MEDICAL | VACCINATION | SHELTER
  amount      Float
  frequency   String   @default("MONTHLY") // ONE_TIME | MONTHLY
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  animal Animal? @relation(fields: [animalId], references: [id])

  @@map("animal_pledges")
}

// ==================== AMBULANCE & AI GREEN CORRIDOR ====================

model Ambulance {
  id          String  @id @default(cuid())
  code        String  @unique
  type        String  @default("BLS") // BLS | ALS | PTV | NEONATAL
  status      String  @default("AVAILABLE") // AVAILABLE | ON_MISSION | MAINTENANCE
  base        String
  driverName  String
  driverPhone String?
  crew        String?
  equipment   String?

  missions Mission[]

  @@map("ambulances")
}

model Mission {
  id              String   @id @default(cuid())
  requestRef      String   @unique
  patientName     String
  contact         String
  emergencyType   String   @default("CARDIAC") // CARDIAC | ACCIDENT | MATERNITY | BURN | RESPIRATORY | TRANSFER
  priority        String   @default("HIGH") // CRITICAL | HIGH | MEDIUM
  pickup          String
  destination     String
  ambulanceId     String?
  status          String   @default("REQUESTED") // REQUESTED | DISPATCHED | EN_ROUTE | ARRIVED | COMPLETED | CANCELLED
  progress        Int      @default(0)
  route           String? // JSON [{name, congestion, lengthKm}]
  corridorActive  Boolean  @default(false)
  vehiclesAlerted Int      @default(0)
  timeSavedSec    Int      @default(0)
  etaMin          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ambulance Ambulance?      @relation(fields: [ambulanceId], references: [id])
  events    CorridorEvent[]

  @@map("missions")
}

model CorridorEvent {
  id              String   @id @default(cuid())
  missionId       String
  segment         String
  method          String // V2X_5G | CELL_BROADCAST | BLE_MESH | FM_RDS | SIREN
  congestion      String // LOW | MODERATE | HEAVY | GRIDLOCK
  vehiclesAlerted Int      @default(0)
  timeSavedSec    Int      @default(0)
  note            String?
  createdAt       DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id])

  @@map("corridor_events")
}

// ==================== RATION KIT SYSTEM ====================

model KitTemplate {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("RATION") // RATION | FOOD | EDUCATION | MEDICAL | HYGIENE | CLOTHING | EMERGENCY | CUSTOM
  codePrefix  String?  // e.g. UAR-RK, UAR-EK — derived from kind when null
  description String?
  image       String?
  items       String // JSON [{name, qty, unit}]
  costPerUnit Float    @default(0)
  status      String   @default("ACTIVE") // ACTIVE | RETIRED
  createdAt   DateTime @default(now())

  batches KitBatch[]

  @@map("kit_templates")
}

model KitBatch {
  id           String   @id @default(cuid())
  templateId   String
  name         String
  totalUnits   Int
  scannedUnits Int      @default(0)
  instructions String?
  status       String   @default("READY") // READY | IN_PROGRESS | DEPLETED
  createdAt    DateTime @default(now())

  template KitTemplate @relation(fields: [templateId], references: [id])
  units    KitUnit[]

  @@map("kit_batches")
}

model KitUnit {
  id            String    @id @default(cuid())
  batchId       String
  code          String    @unique // UAR-RK-2026-000001
  status        String    @default("READY") // READY | SCANNED | EXPIRED
  scannedAt     DateTime?
  scannedById   String?
  scannedByName String?
  location      String?

  batch KitBatch @relation(fields: [batchId], references: [id])

  @@map("kit_units")
}

// ==================== INVENTORY MANAGEMENT ====================

model InventoryItem {
  id           String    @id @default(cuid())
  name         String
  description  String?
  category     String    @default("OTHER") // FOOD_KIT | SANITARY_PADS | CLOTHING | MEDICINE | ANIMAL_FEED | EQUIPMENT | EDUCATION_MATERIAL | OTHER
  unit         String    @default("piece")
  quantity     Int       @default(0)
  minStock     Int       @default(10)
  pricePerUnit Float?
  location     String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchases     InventoryPurchase[]
  distributions InventoryDistribution[]

  @@map("inventory_items")
}

model InventoryPurchase {
  id           String   @id @default(cuid())
  itemId       String
  quantity     Int
  pricePerUnit Float?
  totalPrice   Float?
  supplier     String?
  invoiceNumber String?
  purchaseDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@map("inventory_purchases")
}

model InventoryDistribution {
  id            String   @id @default(cuid())
  itemId        String
  quantity      Int
  distributionId String?
  notes         String?
  createdAt     DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@map("inventory_distributions")
}

// ==================== DISTRIBUTION TRACKING ====================

model Distribution {
  id            String   @id @default(cuid())
  type          String   @default("FOOD") // FOOD | SANITARY_PADS | MEDICAL | EDUCATION_MATERIAL | CLOTHING | CASH | ANIMAL_FEED | OTHER
  beneficiaryId String?
  volunteerId   String?
  campaignId    String?
  items         String?
  quantity      Int      @default(1)
  value         Float?
  location      String?
  latitude      Float?
  longitude     Float?
  photos        String?
  notes         String?
  distributedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  volunteer   Volunteer?   @relation(fields: [volunteerId], references: [id])

  @@map("distributions")
}

// ==================== SANITARY PADS INITIATIVE ====================

model PadDistribution {
  id               String   @id @default(cuid())
  beneficiaryId    String?
  schoolName       String?
  area             String
  girlsCount       Int      @default(0)
  padsDistributed  Int      @default(0)
  awarenessSession Boolean  @default(false)
  sessionAttendees Int?
  volunteerId      String?
  volunteerName    String?
  distributionDate DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  @@map("pad_distributions")
}

model SchoolCoverage {
  id            String    @id @default(cuid())
  schoolName    String
  address       String?
  city          String?
  contactPerson String?
  contactPhone  String?
  totalGirls    Int       @default(0)
  lastVisited   DateTime?
  visitsCount   Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("school_coverages")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("SYSTEM") // DONATION | CAMPAIGN | DISTRIBUTION | VOLUNTEER | INVENTORY | SYSTEM
  isRead    Boolean  @default(false)
  actionUrl String?
  sentVia   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ==================== ACTIVITY LOGS ====================

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// ==================== SETTINGS ====================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  isSecret    Boolean  @default(false) // masked in API responses
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// ==================== CERTIFICATES (80G receipts live on Donation.receiptNumber) ====================

model Certificate {
  id             String   @id @default(cuid())
  code           String   @unique // UAR-CERT-2026-00001
  type           String // DONOR_APPRECIATION | VOLUNTEER_SERVICE | ANIMAL_ADOPTION | MEDICINE_SPONSOR | PAD_DRIVE_CHAMPION
  recipientName  String
  recipientEmail String?
  userId         String?
  title          String
  description    String?
  refType        String? // DONATION | PLEDGE | ANIMAL | VOLUNTEER | CAMPAIGN
  refId          String?
  issuedBy       String?
  meta           String? // JSON extras (hours, campaign, animal name…)
  issuedAt       DateTime @default(now())

  @@map("certificates")
}

// ==================== CONTACT QUERIES ====================

model ContactQuery {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  status     String    @default("PENDING") // PENDING | RESOLVED | CLOSED
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("contact_queries")
}

// ==================== TESTIMONIALS ====================

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  message   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@map("testimonials")
}
