// United Angel Reach - Charitable Trust Management System
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  ADMIN
  VOLUNTEER
  DONOR
  BENEFICIARY
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  phone         String?
  name          String
  password      String
  role          UserRole    @default(DONOR)
  avatar        String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  donations     Donation[]
  volunteer     Volunteer?
  beneficiary   Beneficiary?
  notifications Notification[]
  activities    ActivityLog[]
  
  @@map("users")
}

// ==================== DONATION MODULE ====================

enum DonationType {
  ONE_TIME
  RECURRING
}

enum DonationCategory {
  FOOD_DISTRIBUTION
  EDUCATION_SUPPORT
  SANITARY_PADS
  GENERAL
  MEDICAL
  EMERGENCY
}

enum PaymentMethod {
  UPI
  RAZORPAY
  STRIPE
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Donation {
  id              String          @id @default(cuid())
  donorId         String?
  donorName       String
  donorEmail      String
  donorPhone      String?
  amount          Float
  currency        String          @default("INR")
  type            DonationType    @default(ONE_TIME)
  category        DonationCategory @default(GENERAL)
  paymentMethod   PaymentMethod   @default(UPI)
  paymentStatus   PaymentStatus   @default(PENDING)
  transactionId   String?
  receiptNumber   String          @unique
  campaignId      String?
  message         String?
  isAnonymous     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  donor           User?           @relation(fields: [donorId], references: [id])
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  
  @@map("donations")
}

// ==================== CAMPAIGN MANAGEMENT ====================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String          @id @default(cuid())
  title           String
  description     String
  category        DonationCategory @default(GENERAL)
  targetAmount    Float
  raisedAmount    Float           @default(0)
  currency        String          @default("INR")
  startDate       DateTime
  endDate         DateTime?
  location        String?
  images          String?         // JSON array of image URLs
  status          CampaignStatus  @default(DRAFT)
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  donations       Donation[]
  
  @@map("campaigns")
}

// ==================== BENEFICIARY MANAGEMENT ====================

enum BeneficiaryCategory {
  WIDOW
  ORPHAN
  STUDENT
  ELDERLY
  DISABLED
  SINGLE_MOTHER
  POOR_FAMILY
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Beneficiary {
  id              String              @id @default(cuid())
  userId          String?             @unique
  name            String
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  category        BeneficiaryCategory @default(OTHER)
  urgencyLevel    UrgencyLevel        @default(MEDIUM)
  familyMembers   Int                 @default(1)
  monthlyIncome   Float?
  needs           String?             // JSON array of needs
  documents       String?             // JSON array of document URLs
  notes           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  user            User?               @relation(fields: [userId], references: [id])
  distributions   Distribution[]
  padDistributions PadDistribution[]
  
  @@map("beneficiaries")
}

// ==================== VOLUNTEER MANAGEMENT ====================

enum VolunteerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Volunteer {
  id              String          @id @default(cuid())
  userId          String          @unique
  skills          String?         // JSON array of skills
  availability    String?         // JSON for availability schedule
  assignedArea    String?
  emergencyContact String?
  idProof         String?         // ID proof document URL
  status          VolunteerStatus @default(PENDING)
  joinedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  user            User            @relation(fields: [userId], references: [id])
  tasks           VolunteerTask[]
  attendances     VolunteerAttendance[]
  distributions   Distribution[]
  
  @@map("volunteers")
}

model VolunteerTask {
  id              String          @id @default(cuid())
  volunteerId     String
  title           String
  description     String?
  location        String?
  scheduledDate   DateTime
  status          String          @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  volunteer       Volunteer       @relation(fields: [volunteerId], references: [id])
  
  @@map("volunteer_tasks")
}

model VolunteerAttendance {
  id              String          @id @default(cuid())
  volunteerId     String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  location        String?
  notes           String?
  createdAt       DateTime        @default(now())
  
  // Relations
  volunteer       Volunteer       @relation(fields: [volunteerId], references: [id])
  
  @@unique([volunteerId, date])
  @@map("volunteer_attendances")
}

// ==================== INVENTORY MANAGEMENT ====================

enum InventoryCategory {
  FOOD_KIT
  SANITARY_PADS
  CLOTHING
  MEDICINE
  EDUCATION_MATERIAL
  OTHER
}

model InventoryItem {
  id              String              @id @default(cuid())
  name            String
  description     String?
  category        InventoryCategory   @default(OTHER)
  unit            String              @default("piece")
  quantity        Int                 @default(0)
  minStock        Int                 @default(10)
  pricePerUnit    Float?
  location        String?
  expiryDate      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  purchases       InventoryPurchase[]
  distributions   InventoryDistribution[]
  
  @@map("inventory_items")
}

model InventoryPurchase {
  id              String          @id @default(cuid())
  itemId          String
  quantity        Int
  pricePerUnit    Float?
  totalPrice      Float?
  supplier        String?
  invoiceNumber   String?
  purchaseDate    DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  
  // Relations
  item            InventoryItem   @relation(fields: [itemId], references: [id])
  
  @@map("inventory_purchases")
}

model InventoryDistribution {
  id              String          @id @default(cuid())
  itemId          String
  quantity        Int
  distributionId  String?         // Link to main distribution record
  notes           String?
  createdAt       DateTime        @default(now())
  
  // Relations
  item            InventoryItem   @relation(fields: [itemId], references: [id])
  
  @@map("inventory_distributions")
}

// ==================== DISTRIBUTION TRACKING ====================

enum DistributionType {
  FOOD
  SANITARY_PADS
  EDUCATION_MATERIAL
  CLOTHING
  MEDICAL
  CASH
  OTHER
}

model Distribution {
  id              String            @id @default(cuid())
  type            DistributionType  @default(FOOD)
  beneficiaryId   String?
  volunteerId     String?
  campaignId      String?
  items           String?           // JSON array of distributed items
  quantity        Int               @default(1)
  value           Float?
  location        String?
  latitude        Float?
  longitude       Float?
  photos          String?           // JSON array of photo URLs
  notes           String?
  distributedAt   DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  beneficiary     Beneficiary?      @relation(fields: [beneficiaryId], references: [id])
  volunteer       Volunteer?        @relation(fields: [volunteerId], references: [id])
  
  @@map("distributions")
}

// ==================== SANITARY PADS INITIATIVE ====================

model PadDistribution {
  id              String          @id @default(cuid())
  beneficiaryId   String?
  schoolName      String?
  area            String
  girlsCount      Int             @default(0)
  padsDistributed Int             @default(0)
  awarenessSession Boolean        @default(false)
  sessionAttendees Int?
  volunteerId     String?
  distributionDate DateTime       @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  beneficiary     Beneficiary?    @relation(fields: [beneficiaryId], references: [id])
  
  @@map("pad_distributions")
}

model SchoolCoverage {
  id              String          @id @default(cuid())
  schoolName      String
  address         String?
  city            String?
  contactPerson   String?
  contactPhone    String?
  totalGirls      Int             @default(0)
  lastVisited     DateTime?
  visitsCount     Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@map("school_coverages")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  DONATION
  CAMPAIGN
  DISTRIBUTION
  VOLUNTEER
  INVENTORY
  SYSTEM
}

model Notification {
  id              String            @id @default(cuid())
  userId          String?
  title           String
  message         String
  type            NotificationType  @default(SYSTEM)
  isRead          Boolean           @default(false)
  actionUrl       String?
  sentVia         String?           // APP, SMS, WHATSAPP, EMAIL
  createdAt       DateTime          @default(now())
  
  // Relations
  user            User?             @relation(fields: [userId], references: [id])
  
  @@map("notifications")
}

// ==================== ACTIVITY LOGS ====================

model ActivityLog {
  id              String          @id @default(cuid())
  userId          String?
  action          String
  entityType      String          // DONATION, CAMPAIGN, BENEFICIARY, etc.
  entityId        String?
  details         String?         // JSON for additional details
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  
  // Relations
  user            User?           @relation(fields: [userId], references: [id])
  
  @@map("activity_logs")
}

// ==================== SETTINGS ====================

model Setting {
  id              String          @id @default(cuid())
  key             String          @unique
  value           String
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@map("settings")
}

// ==================== CONTACT QUERIES ====================

model ContactQuery {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  status          String          @default("PENDING") // PENDING, RESOLVED, CLOSED
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@map("contact_queries")
}
